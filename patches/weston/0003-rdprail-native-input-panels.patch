+static void
+reset_listener(struct wl_listener *listener)
+{
+	wl_list_remove(&listener->link);
+	wl_list_init(&listener->link);
+}
+
+static void
+hide_panel(struct input_panel_surface *panel)
+{
+	/* Unmapped surfaces have output_mask=0: the repaint iterator cannot
+	 * hide their host windows. Send a state-only hide before dropping owner. */
+	if (!panel->shell->input_panel.shutting_down)
+		panel->shell->input_panel.rail_api->set_input_panel(panel->surface,
+								 NULL, false);
+	weston_surface_unmap(panel->surface);
+}
+
+static void
+panel_output_destroyed(struct wl_listener *listener, void *data)
+{
+	struct input_panel_surface *panel =
+		container_of(listener, struct input_panel_surface,
+			     output_destroy_listener);
+	(void)data;
+	hide_panel(panel);
+	reset_listener(&panel->output_destroy_listener);
+	panel->output = NULL;
+}
+
+static void
+set_panel_output(struct input_panel_surface *panel, struct weston_output *output)
+{
+	if (panel->output == output)
+		return;
+	reset_listener(&panel->output_destroy_listener);
+	panel->output = output;
+	if (output)
+		wl_signal_add(&output->destroy_signal,
+			      &panel->output_destroy_listener);
+}
+
+static bool
+parent_is_visible(struct desktop_shell *shell, struct weston_view **view)
+{
+	struct weston_surface *parent = shell->text_input.surface;
+	struct weston_surface_rail_state *rail;
+	if (!shell->input_panel.showing || !parent ||
+	    !weston_surface_is_mapped(parent) || !parent->output)
+		return false;
+	rail = parent->backend_state;
+	if (rail && (rail->showState_requested == RDP_WINDOW_HIDE ||
+		     rail->showState_requested == RDP_WINDOW_SHOW_MINIMIZED))
+		return false;
+	*view = get_default_view(parent);
+	return *view && weston_view_is_mapped(*view);
+}
+
+static void
+position_panel(struct input_panel_surface *panel)
+{
+	struct desktop_shell *shell = panel->shell;
+	struct weston_view *parent_view;
+	struct weston_output *output;
+	struct shell_output *shell_output;
+	pixman_rectangle32_t area;
+	float x, y, above, unused_x;
+	int32_t max_x, max_y;
+	if (!panel->configured || panel->surface->width <= 0 ||
+	    panel->surface->height <= 0 ||
+	    !parent_is_visible(shell, &parent_view)) {
+		hide_panel(panel);
+		return;
+	}
+	output = shell->text_input.surface->output;
+	set_panel_output(panel, output);
+	area = (pixman_rectangle32_t){output->x, output->y,
+				     output->width, output->height};
+	wl_list_for_each(shell_output, &shell->output_list, link) {
+		if (shell_output->output == output &&
+		    shell_output->desktop_workarea.width > 0 &&
+		    shell_output->desktop_workarea.height > 0) {
+			area = shell_output->desktop_workarea;
+			break;
+		}
+	}
+	if (panel->overlay) {
+		weston_view_to_global_float(parent_view,
+			shell->text_input.cursor_rectangle.x1,
+			shell->text_input.cursor_rectangle.y2, &x, &y);
+		weston_view_to_global_float(parent_view,
+			shell->text_input.cursor_rectangle.x1,
+			shell->text_input.cursor_rectangle.y1, &unused_x, &above);
+		if (y + panel->surface->height > area.y + (int32_t)area.height)
+			y = above - panel->surface->height;
+	} else {
+		x = area.x + ((int32_t)area.width - panel->surface->width) / 2;
+		y = area.y + (int32_t)area.height - panel->surface->height;
+	}
+	max_x = area.x + (int32_t)area.width - panel->surface->width;
+	max_y = area.y + (int32_t)area.height - panel->surface->height;
+	x = fmaxf(area.x, fminf(x, max_x));
+	y = fmaxf(area.y, fminf(y, max_y));
+	weston_view_set_position(panel->view, floorf(x), floorf(y));
+	if (!weston_view_is_mapped(panel->view)) {
+		weston_layer_entry_insert(&shell->input_panel.layer.view_list,
+					 &panel->view->layer_link);
+		panel->surface->is_mapped = true;
+		panel->view->is_mapped = true;
+	}
+	weston_view_geometry_dirty(panel->view);
+	weston_view_update_transform(panel->view);
+	shell->input_panel.rail_api->set_input_panel(panel->surface,
+						   shell->text_input.surface, true);
+	weston_surface_damage(panel->surface);
+}
