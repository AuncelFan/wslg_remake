+/* State-only input-panel path: no output, buffer, frame or ACK dependency. */
+static void
+rdp_rail_set_input_panel(struct weston_surface *surface,
+			 struct weston_surface *parent, bool visible)
+{
+	struct rdp_backend *b = to_rdp_backend(surface->compositor);
+	struct weston_surface_rail_state *rail_state = surface->backend_state;
+	struct weston_surface_rail_state *parent_state;
+	RdpPeerContext *peer_ctx;
+	rdpUpdate *update;
+	WINDOW_ORDER_INFO info = {};
+	WINDOW_STATE_ORDER state = {};
+	uint32_t owner = RDP_RAIL_DESKTOP_WINDOW_ID;
+	uint32_t requested;
+	bool changed;
+	BOOL sent;
+	if (!rdp_rail_is_input_panel(surface))
+		return;
+	if (!b || !b->rdp_peer || !b->rdp_peer->context)
+		return;
+	assert_compositor_thread(b);
+	if (!rail_state && visible) {
+		rdp_rail_create_window(NULL, surface);
+		rail_state = surface->backend_state;
+	}
+	if (!rail_state)
+		return;
+	if (!visible || !parent || parent == surface ||
+	    parent->compositor != surface->compositor)
+		parent = NULL;
+	parent_state = parent ? parent->backend_state : NULL;
+	if (parent_state && parent_state->isWindowCreated &&
+	    weston_surface_is_mapped(parent))
+		owner = parent_state->window_id;
+	else {
+		visible = false;
+		parent = NULL;
+	}
+	requested = visible ? RDP_WINDOW_SHOW : RDP_WINDOW_HIDE;
+	changed = !rail_state->input_panel_configured ||
+		rail_state->parent_surface != parent ||
+		rail_state->parent_window_id != owner ||
+		rail_state->showState_requested != requested;
+	rail_state->parent_surface = parent;
+	rail_state->showState_requested = requested;
+	if (!rail_state->isWindowCreated || rail_state->error)
+		return;
+	peer_ctx = (RdpPeerContext *)b->rdp_peer->context;
+	if (!changed && (visible || rail_state->showState == RDP_WINDOW_HIDE))
+		return;
+	info.windowId = rail_state->window_id;
+	info.fieldFlags = WINDOW_ORDER_TYPE_WINDOW | WINDOW_ORDER_FIELD_STYLE |
+		WINDOW_ORDER_FIELD_OWNER | WINDOW_ORDER_FIELD_TASKBAR_BUTTON;
+	state.style = RAIL_INPUT_PANEL_STYLE;
+	state.extendedStyle = RAIL_INPUT_PANEL_EXSTYLE;
+	state.ownerWindowId = owner;
+	state.TaskbarButton = 1;
+	if (!visible) {
+		info.fieldFlags |= WINDOW_ORDER_FIELD_SHOW;
+		state.showState = WINDOW_HIDE;
+	}
+	update = b->rdp_peer->context->update;
+	update->BeginPaint(update->context);
+	sent = update->window->WindowUpdate(update->context, &info, &state);
+	update->EndPaint(update->context);
+	if (!sent) {
+		rail_state->forceUpdateWindowState = true;
+		rdp_debug_error(b, "input panel WindowUpdate failed (windowId:0x%x)\n",
+				rail_state->window_id);
+		return;
+	}
+	if (!visible)
+		rail_state->showState = RDP_WINDOW_HIDE;
+	/* The style and OWNER=desktop must be sent even after parent=NULL. */
+	rail_state->parent_window_id = owner;
+	rail_state->taskbarButton = 1;
+	rail_state->input_panel_configured = true;
+	rail_state->forceUpdateWindowState = true;
+	peer_ctx->is_window_zorder_dirty = true;
+	if (visible)
+		weston_surface_damage(surface);
+}
