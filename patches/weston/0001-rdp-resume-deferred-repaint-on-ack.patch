+/* ACKs release RAIL backpressure on a channel thread. Keep their immediate
+ * state updates: window destruction may wait for them on the compositor
+ * thread. Only the repaint wakeup is dispatched to the display loop.
+ */
+static void
+rdp_rail_resume_repaint(bool freeOnly, void *arg)
+{
+	struct rdp_loop_task *task = arg;
+	RdpPeerContext *peer_ctx = task->peerCtx;
+	struct rdp_backend *b;
+	struct weston_output *output;
+
+	if (freeOnly)
+		goto out;
+
+	b = peer_ctx->rdpBackend;
+	assert_compositor_thread(b);
+
+	pthread_mutex_lock(&peer_ctx->loop_task_list_mutex);
+	peer_ctx->rail_repaint_task_pending = false;
+	pthread_mutex_unlock(&peer_ctx->loop_task_list_mutex);
+
+	if (!peer_ctx->isAcknowledgedSuspended &&
+	    (peer_ctx->currentFrameId - peer_ctx->acknowledgedFrameId) >= 2)
+		goto out;
+
+	/* The live output list avoids retaining surface/output pointers across
+	 * threads and excludes outputs disabled or destroyed before dispatch.
+	 * The flag is cleared by the next repaint, not by this wakeup.
+	 */
+	wl_list_for_each(output, &b->compositor->output_list, link) {
+		if (to_rdp_output(output)->rail_repaint_deferred) {
+			rdp_debug_verbose(b, "resuming deferred RAIL repaint: output %u\n",
+					  output->id);
+			weston_output_schedule_repaint(output);
+		}
+	}
+out:
+	free(task);
+}
+
+static void
+rdp_rail_queue_repaint(RdpPeerContext *peer_ctx)
+{
+	struct rdp_loop_task *task;
+
+	assert_not_compositor_thread(peer_ctx->rdpBackend);
+
+	pthread_mutex_lock(&peer_ctx->loop_task_list_mutex);
+	if (peer_ctx->rail_repaint_task_pending) {
+		pthread_mutex_unlock(&peer_ctx->loop_task_list_mutex);
+		return;
+	}
+	peer_ctx->rail_repaint_task_pending = true;
+	pthread_mutex_unlock(&peer_ctx->loop_task_list_mutex);
+
+	task = xmalloc(sizeof *task);
+	rdp_dispatch_task_to_display_loop(peer_ctx, rdp_rail_resume_repaint, task);
+}
+
